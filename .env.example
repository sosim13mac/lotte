# ── Supabase ───────────────────────────────────────────────
# 비워두면 "데모 모드"로 실행됩니다 (로그인 없이 로컬 샘플 데이터로 동작).
NEXT_PUBLIC_SUPABASE_URL=
# 새 프로젝트: Publishable key(sb_publishable_...) / 기존 프로젝트: anon key 둘 중 하나
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 강제로 데모 모드를 켜고 싶을 때
# NEXT_PUBLIC_DEMO_MODE=1

# ── Supabase CLI (supabase/config.toml 에서 env()로 참조) ────
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ── 카카오맵 (명당 지도) ───────────────────────────────────
# Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키
# 플랫폼 > Web 에 사이트 도메인(http://localhost:3000, 운영 도메인) 등록 필요. 비우면 간이 지도로 표시.
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── FCM 웹 푸시 (단골점 당첨 / 회차 결과) ─────────────────
# Firebase 콘솔 > 프로젝트 설정 > 일반(웹 앱 구성) / 클라우드 메시징(웹 푸시 인증서 = VAPID 키)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
