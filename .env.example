# ── Neon (DB) + Better Auth (로그인) ───────────────────────
# NEXT_PUBLIC_BACKEND 가 neon 이 아니면 "데모 모드"(로그인 없이 로컬 샘플 데이터)로 실행됩니다.
NEXT_PUBLIC_BACKEND=neon
# Neon 콘솔 > Connect > 연결 문자열 (서버 전용 — 절대 커밋 금지)
DATABASE_URL=
# 세션 서명용 비밀값: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# 서비스 주소 (로컬: http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000
# 강제로 데모 모드를 켜고 싶을 때
# NEXT_PUBLIC_DEMO_MODE=1

# Google 로그인 (선택): 값을 넣고 NEXT_PUBLIC_GOOGLE_LOGIN=1 로 켭니다.
# 리디렉션 URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_LOGIN=
# ── 카카오맵 (명당 지도) ───────────────────────────────────
# Kakao Developers > 내 애플리케이션 > 앱 키 > JavaScript 키
# 플랫폼 > Web 에 사이트 도메인(http://localhost:3000, 운영 도메인) 등록 필요. 비우면 간이 지도로 표시.
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── FCM 웹 푸시 (단골점 당첨 / 회차 결과) ─────────────────
# Firebase 콘솔 > 프로젝트 설정 > 일반(웹 앱 구성) / 클라우드 메시징(웹 푸시 인증서 = VAPID 키)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=


# ── 당첨번호 크롤러 (/api/cron/crawl-draw) ─────────────────
# Vercel Cron 이 이 값을 Authorization: Bearer 로 자동 전송합니다. 임의의 긴 문자열.
CRON_SECRET=
# 판매점 주소 → 좌표 (Kakao Developers > REST API 키, 선택)
KAKAO_REST_API_KEY=
# FCM 푸시 (선택): 서비스 계정 JSON 한 줄 + 배포 도메인
FCM_SERVICE_ACCOUNT=
APP_URL=

# ── 문의 게시판 · 개인정보 처리방침 ───────────────────────
# 운영자 이메일(쉼표로 여러 명). 이 계정으로 로그인하면 문의 게시판에서 전체 문의를 보고 답변할 수 있습니다 (서버 전용).
ADMIN_EMAILS=
# 처리방침 "보호 문의처"에 표시됩니다. 비워 두면 그 줄을 숨깁니다.
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
